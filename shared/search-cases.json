{
  "_doc": "Search test cases (docs/API.md 'Search'; app app/lib/domain/insights.dart searchDocs). items = SearchDoc {id, groupId (optional), date, description, notes, comments (texts of non-deleted comments), category (the stored value as is), amount (minor units of the expense currency, positive for refunds too), currency}. cases: searchDocs(items, query, category?, month?) → expected (ids, date descending, then id ascending). Decimals from shared/currencies.json. Only the app (Dart) reads it for now.",
  "items": [
    {"id": "x1", "date": "2026-10-02", "description": "Café Florian", "notes": null, "comments": [], "category": "food.dining_out", "amount": 1250, "currency": "EUR"},
    {"id": "x2", "date": "2026-10-05", "description": "Taxi", "notes": "to the airport, 4 bags", "comments": ["Anna paid the tip"], "category": "transportation.taxi", "amount": 1200, "currency": "EUR"},
    {"id": "x3", "date": "2026-09-30", "description": "Room upgrade", "notes": null, "comments": [], "category": null, "amount": 11200, "currency": "EUR"},
    {"id": "x4", "date": "2026-10-05", "description": "Ramen", "notes": null, "comments": [], "category": "Food", "amount": 12000, "currency": "JPY"}
  ],
  "cases": [
    {"name": "diacritics", "query": "cafe", "expected": ["x1"]},
    {"name": "amount in major units; 112.00 and JPY 12000 don't match", "query": "12", "expected": ["x2", "x1"]},
    {"name": "decimal comma", "query": "12,5", "expected": ["x1"]},
    {"name": "two decimals", "query": "12,50", "expected": ["x1"]},
    {"name": "more decimals than the currency has never matches", "query": "12.001", "expected": []},
    {"name": "minor units are not a major amount", "query": "1250", "expected": []},
    {"name": "zero-decimal currency", "query": "12000", "expected": ["x4"]},
    {"name": "AND across notes and comments", "query": "airport anna", "expected": ["x2"]},
    {"name": "extra spaces and upper case", "query": "  AIRPORT   tip ", "expected": ["x2"]},
    {"name": "legacy raw text and parent label", "query": "food", "expected": ["x4", "x1"]},
    {"name": "resolved label of null and legacy categories", "query": "general", "expected": ["x4", "x3"]},
    {"name": "parent label prefix", "query": "transport", "expected": ["x2"]},
    {"name": "filters only", "query": "", "category": "transportation", "month": "2026-10", "expected": ["x2"]},
    {"name": "full key filter", "query": "", "category": "food.dining_out", "expected": ["x1"]},
    {"name": "uncategorized filter takes null and legacy values", "query": "", "category": "uncategorized", "expected": ["x4", "x3"]},
    {"name": "month filter", "query": "", "month": "2026-09", "expected": ["x3"]},
    {"name": "query and filter must both match", "query": "taxi", "category": "food", "expected": []},
    {"name": "empty query without a filter", "query": "  ", "expected": []}
  ]
}
