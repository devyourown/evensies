{
  "_doc": "이벤트 적용기 테스트 케이스. events를 seq 순서로 빈 상태에 적용하면 expected 상태가 되어야 한다. 같은 이벤트를 두 번 적용해도 결과가 같아야 하고(멱등), 'permute': true인 케이스는 이벤트를 어떤 순서로 적용해도(seq 기준 충돌 규칙 적용 후) 최종 상태가 같아야 한다. Dart·Kotlin 적용기가 이 파일을 읽는다. 날짜는 YYYY-MM-DD, 금액은 정수.",
  "cases": [
    {
      "name": "create expense then update description only",
      "events": [
        {"seq": 1, "clientId": "e1", "type": "member.added", "payload": {"memberId": "m1", "name": "Anna", "userId": null}},
        {"seq": 2, "clientId": "e2", "type": "member.added", "payload": {"memberId": "m2", "name": "Ben", "userId": null}},
        {"seq": 3, "clientId": "e3", "type": "expense.created", "payload": {"expenseId": "x1", "description": "Dinner", "amount": 2000, "currency": "EUR", "fxRateToDefault": null, "paidBy": "m1", "date": "2026-10-10", "category": null, "shares": [{"memberId": "m1", "amount": 1000}, {"memberId": "m2", "amount": 1000}]}},
        {"seq": 4, "clientId": "e4", "type": "expense.updated", "payload": {"expenseId": "x1", "fields": {"description": "Dinner at Luigi"}}}
      ],
      "expected": {
        "members": [{"id": "m1", "name": "Anna", "userId": null}, {"id": "m2", "name": "Ben", "userId": null}],
        "expenses": [{"id": "x1", "description": "Dinner at Luigi", "amount": 2000, "currency": "EUR", "fxRateToDefault": null, "paidBy": "m1", "date": "2026-10-10", "category": null, "deleted": false, "shares": [{"memberId": "m1", "amount": 1000}, {"memberId": "m2", "amount": 1000}]}],
        "payments": []
      }
    },
    {
      "name": "delete wins over later update",
      "events": [
        {"seq": 1, "clientId": "e1", "type": "member.added", "payload": {"memberId": "m1", "name": "Anna", "userId": null}},
        {"seq": 2, "clientId": "e2", "type": "expense.created", "payload": {"expenseId": "x1", "description": "Taxi", "amount": 900, "currency": "EUR", "fxRateToDefault": null, "paidBy": "m1", "date": "2026-10-10", "category": null, "shares": [{"memberId": "m1", "amount": 900}]}},
        {"seq": 3, "clientId": "e3", "type": "expense.deleted", "payload": {"expenseId": "x1"}},
        {"seq": 4, "clientId": "e4", "type": "expense.updated", "payload": {"expenseId": "x1", "fields": {"amount": 1000}}}
      ],
      "expected": {
        "members": [{"id": "m1", "name": "Anna", "userId": null}],
        "expenses": [{"id": "x1", "description": "Taxi", "amount": 900, "currency": "EUR", "fxRateToDefault": null, "paidBy": "m1", "date": "2026-10-10", "category": null, "deleted": true, "shares": [{"memberId": "m1", "amount": 900}]}],
        "payments": []
      }
    },
    {
      "name": "field-level last write wins, permutation safe",
      "permute": true,
      "events": [
        {"seq": 1, "clientId": "e1", "type": "member.added", "payload": {"memberId": "m1", "name": "Anna", "userId": null}},
        {"seq": 2, "clientId": "e2", "type": "expense.created", "payload": {"expenseId": "x1", "description": "Hotel", "amount": 10000, "currency": "EUR", "fxRateToDefault": null, "paidBy": "m1", "date": "2026-10-10", "category": null, "shares": [{"memberId": "m1", "amount": 10000}]}},
        {"seq": 3, "clientId": "e3", "type": "expense.updated", "payload": {"expenseId": "x1", "fields": {"description": "Hotel Roma"}}},
        {"seq": 4, "clientId": "e4", "type": "expense.updated", "payload": {"expenseId": "x1", "fields": {"amount": 12000, "shares": [{"memberId": "m1", "amount": 12000}]}}},
        {"seq": 5, "clientId": "e5", "type": "expense.updated", "payload": {"expenseId": "x1", "fields": {"description": "Hotel Roma 2 nights"}}}
      ],
      "expected": {
        "members": [{"id": "m1", "name": "Anna", "userId": null}],
        "expenses": [{"id": "x1", "description": "Hotel Roma 2 nights", "amount": 12000, "currency": "EUR", "fxRateToDefault": null, "paidBy": "m1", "date": "2026-10-10", "category": null, "deleted": false, "shares": [{"memberId": "m1", "amount": 12000}]}],
        "payments": []
      }
    },
    {
      "name": "member linked to user, payment created and deleted",
      "events": [
        {"seq": 1, "clientId": "e1", "type": "member.added", "payload": {"memberId": "m1", "name": "Anna", "userId": null}},
        {"seq": 2, "clientId": "e2", "type": "member.added", "payload": {"memberId": "m2", "name": "Ben", "userId": null}},
        {"seq": 3, "clientId": "e3", "type": "member.linked", "payload": {"memberId": "m2", "userId": "u-ben"}},
        {"seq": 4, "clientId": "e4", "type": "payment.created", "payload": {"paymentId": "p1", "fromMember": "m2", "toMember": "m1", "amount": 500, "currency": "EUR", "date": "2026-10-11"}},
        {"seq": 5, "clientId": "e5", "type": "payment.created", "payload": {"paymentId": "p2", "fromMember": "m2", "toMember": "m1", "amount": 100, "currency": "EUR", "date": "2026-10-12"}},
        {"seq": 6, "clientId": "e6", "type": "payment.deleted", "payload": {"paymentId": "p2"}}
      ],
      "expected": {
        "members": [{"id": "m1", "name": "Anna", "userId": null}, {"id": "m2", "name": "Ben", "userId": "u-ben"}],
        "expenses": [],
        "payments": [
          {"id": "p1", "fromMember": "m2", "toMember": "m1", "amount": 500, "currency": "EUR", "date": "2026-10-11", "deleted": false},
          {"id": "p2", "fromMember": "m2", "toMember": "m1", "amount": 100, "currency": "EUR", "date": "2026-10-12", "deleted": true}
        ]
      }
    },
    {
      "name": "update for unknown expense is ignored",
      "events": [
        {"seq": 1, "clientId": "e1", "type": "member.added", "payload": {"memberId": "m1", "name": "Anna", "userId": null}},
        {"seq": 2, "clientId": "e2", "type": "expense.updated", "payload": {"expenseId": "ghost", "fields": {"amount": 1}}}
      ],
      "expected": {"members": [{"id": "m1", "name": "Anna", "userId": null}], "expenses": [], "payments": []}
    },
    {
      "name": "member removed is marked removed, not dropped",
      "events": [
        {"seq": 1, "clientId": "e1", "type": "member.added", "payload": {"memberId": "m1", "name": "Anna", "userId": null}},
        {"seq": 2, "clientId": "e2", "type": "member.added", "payload": {"memberId": "m2", "name": "Ben", "userId": null}},
        {"seq": 3, "clientId": "e3", "type": "member.removed", "payload": {"memberId": "m2"}}
      ],
      "expected": {"members": [{"id": "m1", "name": "Anna", "userId": null}, {"id": "m2", "name": "Ben", "userId": null, "removed": true}], "expenses": [], "payments": []}
    }
  ]
}
