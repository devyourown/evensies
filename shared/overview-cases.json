{
  "_doc": "Overview cases (the Friends tab, the total card, reminders; docs/API.md 'Overview'). Read by the app's overview_test.dart and the server's OverviewTest. Per group: build the state from the groups[] group (snapshot shape: id, kind, defaultCurrency, simplifyDebts?, members, expenses, payments) → balancesOf / Balances.ofGroup → groupTransfers / Balances.transfers (Phase 4 buckets: a foreign-currency expense joins the default currency through convertExpense when fxRateToDefault > 0, else stays in its own currency's bucket) → GroupLedger.of(me) → computeOverview. person key: userId for a linked member, \"g:<groupId>\" for a placeholder in a friend group, \"m:<memberId>\" for a placeholder in a normal group. My members = every member whose userId is me (removed ones included). Per transfer: when only to is my member, +amount on people[from's key]; when only from is my member, −amount on people[to's key]; when both or neither are mine, ignored. people: person → currency → amount (+ = that person owes me), byGroup: person → groupId → currency → amount; zeros are left out, and so are empty persons and groups. owedToMe / iOwe: per currency the sum of the positives / the absolute value of the sum of the negatives. Invariant (tested): per currency owedToMe − iOwe = the sum of my members' balances over every group. Defaults: fxRateToDefault and category = null, payers = [{paidBy, amount}], deleted = false, status = confirmed, removed = false, simplifyDebts = true.",
  "cases": [
    {"name": "friend group and a shared group net out in one currency", "me": "u-anna",
     "groups": [
      {"id": "g-friend", "kind": "friend", "defaultCurrency": "EUR",
       "members": [{"id": "f1", "name": "Anna", "userId": "u-anna"}, {"id": "f2", "name": "Ben", "userId": "u-ben"}],
       "expenses": [{"id": "x1", "description": "Taxi", "amount": 2000, "currency": "EUR", "paidBy": "f1", "date": "2026-10-01", "shares": [{"memberId": "f1", "amount": 1000}, {"memberId": "f2", "amount": 1000}]}],
       "payments": []},
      {"id": "g-rome", "kind": "group", "defaultCurrency": "EUR",
       "members": [{"id": "r1", "name": "Anna", "userId": "u-anna"}, {"id": "r2", "name": "Ben", "userId": "u-ben"}, {"id": "r3", "name": "Carlo", "userId": null}],
       "expenses": [{"id": "x2", "description": "Hotel", "amount": 9000, "currency": "EUR", "paidBy": "r2", "date": "2026-10-02", "shares": [{"memberId": "r1", "amount": 3000}, {"memberId": "r2", "amount": 3000}, {"memberId": "r3", "amount": 3000}]}],
       "payments": []}],
     "expected": {"people": {"u-ben": {"EUR": -2000}}, "byGroup": {"u-ben": {"g-friend": {"EUR": 1000}, "g-rome": {"EUR": -3000}}},
                  "owedToMe": {}, "iOwe": {"EUR": 2000}}},
    {"name": "currencies never mix; a converted expense counts in EUR, an unconverted one stays in USD", "me": "u-anna",
     "groups": [
      {"id": "g-friend", "kind": "friend", "defaultCurrency": "EUR",
       "members": [{"id": "f1", "name": "Anna", "userId": "u-anna"}, {"id": "f2", "name": "Ben", "userId": "u-ben"}],
       "expenses": [
        {"id": "x1", "description": "Dinner", "amount": 4000, "currency": "EUR", "paidBy": "f2", "date": "2026-10-01", "shares": [{"memberId": "f1", "amount": 2000}, {"memberId": "f2", "amount": 2000}]},
        {"id": "x2", "description": "Museum", "amount": 1000, "currency": "USD", "fxRateToDefault": 0.9, "paidBy": "f1", "date": "2026-10-02", "shares": [{"memberId": "f1", "amount": 500}, {"memberId": "f2", "amount": 500}]},
        {"id": "x3", "description": "Snacks", "amount": 600, "currency": "USD", "paidBy": "f2", "date": "2026-10-03", "shares": [{"memberId": "f1", "amount": 300}, {"memberId": "f2", "amount": 300}]}],
       "payments": []},
      {"id": "g-ny", "kind": "group", "defaultCurrency": "USD",
       "members": [{"id": "n1", "name": "Anna", "userId": "u-anna"}, {"id": "n2", "name": "Ben", "userId": "u-ben"}, {"id": "n3", "name": "Dana", "userId": "u-dana"}],
       "expenses": [{"id": "x4", "description": "Brunch", "amount": 3000, "currency": "USD", "paidBy": "n1", "date": "2026-10-04", "shares": [{"memberId": "n1", "amount": 1000}, {"memberId": "n2", "amount": 1000}, {"memberId": "n3", "amount": 1000}]}],
       "payments": []}],
     "expected": {"people": {"u-ben": {"EUR": -1550, "USD": 700}, "u-dana": {"USD": 1000}},
                  "byGroup": {"u-ben": {"g-friend": {"EUR": -1550, "USD": -300}, "g-ny": {"USD": 1000}}, "u-dana": {"g-ny": {"USD": 1000}}},
                  "owedToMe": {"USD": 1700}, "iOwe": {"EUR": 1550}}},
    {"name": "a debt only in an unconverted bucket stays in its own currency; a payment in that currency settles it (Cara)", "me": "u-anna",
