{
  "_doc": "Split calculation test cases. amount is an integer in minor units. mode: equal | exact | percent | shares | adjustment (input: percent = percentages, shares = share counts, adjustment = adjustments in minor units). members may not be in ascending id order — the remainder goes 1 each from the front in ascending memberId order (for percent and shares only to non-zero members). Instead of expected there may be error (a SplitException code). Both implementations (Dart and Kotlin) read this file. A case with \"pending\": \"<reason>\" is skipped by both tests as \"pending fixture case: <reason>\" until the code passes it.",
  "cases": [
    {"name": "equal 3 ways no remainder", "amount": 3000, "mode": "equal", "members": ["a", "b", "c"], "expected": {"a": 1000, "b": 1000, "c": 1000}},
    {"name": "equal 3 ways remainder 1", "amount": 1000, "mode": "equal", "members": ["a", "b", "c"], "expected": {"a": 334, "b": 333, "c": 333}},
    {"name": "equal 3 ways remainder 2, unsorted input", "amount": 1001, "mode": "equal", "members": ["c", "a", "b"], "expected": {"a": 334, "b": 334, "c": 333}},
    {"name": "equal 1 member", "amount": 777, "mode": "equal", "members": ["z"], "expected": {"z": 777}},
    {"name": "equal zero amount", "amount": 0, "mode": "equal", "members": ["a", "b"], "expected": {"a": 0, "b": 0}},
    {"name": "exact amounts pass through", "amount": 5000, "mode": "exact", "members": ["a", "b"], "input": {"a": 1200, "b": 3800}, "expected": {"a": 1200, "b": 3800}},
    {"name": "exact amounts must sum to total", "amount": 5000, "mode": "exact", "members": ["a", "b"], "input": {"a": 1200, "b": 3000}, "error": "SUM_MISMATCH"},
    {"name": "percent 50/30/20", "amount": 10000, "mode": "percent", "members": ["a", "b", "c"], "input": {"a": 50, "b": 30, "c": 20}, "expected": {"a": 5000, "b": 3000, "c": 2000}},
    {"name": "percent with rounding remainder", "amount": 100, "mode": "percent", "members": ["a", "b", "c"], "input": {"a": 33.33, "b": 33.33, "c": 33.34}, "expected": {"a": 34, "b": 33, "c": 33}},
    {"name": "percent must sum to 100", "amount": 100, "mode": "percent", "members": ["a", "b"], "input": {"a": 60, "b": 50}, "error": "SUM_MISMATCH"},
    {"name": "negative amount rejected", "amount": -5, "mode": "equal", "members": ["a"], "error": "NEGATIVE_AMOUNT"},
    {"name": "no members rejected", "amount": 100, "mode": "equal", "members": [], "error": "NO_MEMBERS"},
    {"name": "shares 2/1/0, leftover to lowest id with a share", "amount": 1000, "mode": "shares", "members": ["a", "b", "c"], "input": {"a": 2, "b": 1, "c": 0}, "expected": {"a": 667, "b": 333, "c": 0}},
    {"name": "shares leftover skips a zero-share lower id, unsorted input", "amount": 100, "mode": "shares", "members": ["c", "a", "b"], "input": {"a": 0, "b": 1, "c": 2}, "expected": {"a": 0, "b": 34, "c": 66}},
    {"name": "shares fractional counts", "amount": 1000, "mode": "shares", "members": ["a", "b", "c"], "input": {"a": 1.5, "b": 1, "c": 0.5}, "expected": {"a": 501, "b": 333, "c": 166}},
    {"name": "shares missing input counts as 0", "amount": 500, "mode": "shares", "members": ["a", "b"], "input": {"a": 1}, "expected": {"a": 500, "b": 0}},
    {"name": "shares counts are rounded to hundredths before dividing", "amount": 1000, "mode": "shares", "members": ["a", "b"], "input": {"a": 1.004, "b": 1.004}, "expected": {"a": 500, "b": 500}},
    {"name": "shares all zero rejected", "amount": 100, "mode": "shares", "members": ["a", "b"], "input": {"a": 0, "b": 0}, "error": "NO_MEMBERS"},
    {"name": "shares negative count rejected", "amount": 100, "mode": "shares", "members": ["a", "b"], "input": {"a": -1, "b": 2}, "error": "INVALID_INPUT"},
    {"name": "adjustment +10 on one person", "amount": 10000, "mode": "adjustment", "members": ["a", "b", "c"], "input": {"a": 1000}, "expected": {"a": 4000, "b": 3000, "c": 3000}},
    {"name": "adjustment negative with remainder", "amount": 1000, "mode": "adjustment", "members": ["a", "b", "c"], "input": {"b": -100}, "expected": {"a": 367, "b": 267, "c": 366}},
    {"name": "adjustment larger than the bill rejected", "amount": 1000, "mode": "adjustment", "members": ["a", "b"], "input": {"a": 1200}, "error": "NEGATIVE_SHARE"},
    {"name": "adjustment pushing someone below zero rejected", "amount": 1000, "mode": "adjustment", "members": ["a", "b"], "input": {"b": -1200}, "error": "NEGATIVE_SHARE"},
    {"name": "adjustment must be whole minor units", "amount": 1000, "mode": "adjustment", "members": ["a", "b"], "input": {"a": 10.5}, "error": "INVALID_INPUT"},
    {"name": "percent within tolerance but over 100 still adds up (divide by the total, not by 100)", "amount": 10000000, "mode": "percent", "members": ["a", "b"], "input": {"a": 50.0009, "b": 50}, "expected": {"a": 5000045, "b": 4999955}},
    {"name": "percent leftover skips 0% members", "amount": 100, "mode": "percent", "members": ["a", "b", "c"], "input": {"a": 0, "b": 33.33, "c": 66.67}, "expected": {"a": 0, "b": 34, "c": 66}}
  ]
}
