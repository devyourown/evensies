# Copy to .env. Never commit secrets.
EVENSIES_DOMAIN=evensies.nariinfo.dev
EVENSIES_PUBLIC_URL=https://evensies.nariinfo.dev
EVENSIES_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
POSTGRES_USER=evensies
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evensies
# Sign-in providers (a self-hosting operator registers their own)
EVENSIES_APPLE_CLIENT_ID=dev.nariinfo.evensies
EVENSIES_GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# Web app (/app/) sign-in. Empty = no such button on the web
EVENSIES_APPLE_SERVICES_ID=dev.nariinfo.evensies.web
EVENSIES_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# Development only (flutter run -d chrome). Leave empty in production: same origin
#EVENSIES_CORS_ORIGINS=http://localhost:7357
# Push (optional). Without it the server runs without push
#EVENSIES_FCM_CREDENTIALS_FILE=/secrets/fcm.json
# Email (optional). An empty SMTP_HOST turns off email sign-in, invites and summary emails, and the app hides those screens
#EVENSIES_SMTP_HOST=smtp.resend.com
#EVENSIES_SMTP_PORT=587
#EVENSIES_SMTP_USER=resend
# Secret: keep it in .env only, never commit it (for Resend, the API key)
#EVENSIES_SMTP_PASSWORD=
# starttls (default), ssl (465), none (Mailpit only)
#EVENSIES_SMTP_TLS=starttls
# Sender. Must be on a verified domain
#EVENSIES_EMAIL_FROM=Evensies <no-reply@evensies.nariinfo.dev>
# Max emails per 24 hours (0 = no limit). Resend Free allows 100
#EVENSIES_EMAIL_DAILY_LIMIT=100
# Resend webhook signing secret (whsec_…, a secret). Empty turns /webhooks/email off
#EVENSIES_EMAIL_WEBHOOK_SECRET=
# Operator contact address shown in Help and Report. Empty = GitHub only and no Report menu
#EVENSIES_SUPPORT_EMAIL=
# Store review sign-in (optional): the username and password reviewers enter after "Demo sign-in" (Play Console → App access).
# Off unless both are set and the password has at least 20 characters; a shorter password keeps it off and logs a warning
#EVENSIES_REVIEW_LOGIN_USERNAME=
#EVENSIES_REVIEW_LOGIN_PASSWORD=
# Development only. Never true in production
EVENSIES_AUTH_DEV_LOGIN=false
