# 복사해서 .env 로 저장. 비밀값은 커밋하지 않는다.
TALLY_DOMAIN=tally.example.com
TALLY_PUBLIC_URL=https://tally.example.com
TALLY_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
POSTGRES_USER=tally
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tally
# 로그인 제공자 (셀프호스팅 운영자가 직접 발급)
TALLY_APPLE_CLIENT_ID=dev.nariinfo.tally
TALLY_GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# 푸시 (선택). 없으면 푸시 없이 동작
#TALLY_FCM_CREDENTIALS_FILE=/secrets/fcm.json
# 개발 전용. 운영에서는 절대 true로 두지 않는다
TALLY_AUTH_DEV_LOGIN=false
