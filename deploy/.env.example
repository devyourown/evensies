# 복사해서 .env 로 저장. 비밀값은 커밋하지 않는다.
EVENSIES_DOMAIN=evensies.nariinfo.dev
EVENSIES_PUBLIC_URL=https://evensies.nariinfo.dev
EVENSIES_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
POSTGRES_USER=evensies
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evensies
# 로그인 제공자 (셀프호스팅 운영자가 직접 발급)
EVENSIES_APPLE_CLIENT_ID=dev.nariinfo.evensies
EVENSIES_GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
# 웹 앱(/app/) 로그인. 비우면 웹에 그 버튼이 없다
EVENSIES_APPLE_SERVICES_ID=dev.nariinfo.evensies.web
EVENSIES_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# 개발 전용(flutter run -d chrome). 운영은 같은 origin이라 비워 둔다
#EVENSIES_CORS_ORIGINS=http://localhost:7357
# 푸시 (선택). 없으면 푸시 없이 동작
#EVENSIES_FCM_CREDENTIALS_FILE=/secrets/fcm.json
# 이메일 (선택). SMTP_HOST를 비우면 이메일 로그인·초대·요약 메일이 모두 꺼지고 앱도 그 화면을 숨긴다
#EVENSIES_SMTP_HOST=smtp.resend.com
#EVENSIES_SMTP_PORT=587
#EVENSIES_SMTP_USER=resend
# 비밀값: .env에만 두고 커밋하지 않는다 (Resend는 API 키)
#EVENSIES_SMTP_PASSWORD=
# starttls(기본), ssl(465), none(Mailpit 전용)
#EVENSIES_SMTP_TLS=starttls
# 보내는 사람. 검증된 도메인이어야 한다
#EVENSIES_EMAIL_FROM=Evensies <no-reply@evensies.nariinfo.dev>
# 24시간 동안 보낼 메일 수 상한(0 = 없음). Resend Free는 100
#EVENSIES_EMAIL_DAILY_LIMIT=100
# Resend 웹훅 서명 비밀(whsec_…, 비밀값). 비우면 /webhooks/email이 꺼진다
#EVENSIES_EMAIL_WEBHOOK_SECRET=
# 도움말·신고에 보이는 운영자 연락 주소. 비우면 GitHub만 보이고 신고 메뉴가 없다
#EVENSIES_SUPPORT_EMAIL=
# 개발 전용. 운영에서는 절대 true로 두지 않는다
EVENSIES_AUTH_DEV_LOGIN=false
