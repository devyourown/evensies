{
  "_doc": "Itemized split cases (docs/API.md '항목별 분할'), read by app/test/itemized_test.dart only: the server never recomputes shares. Minor-unit integers. Lines with the same set of memberIds (in any order) are added up first, then each sum splits equally between those members (remainder +1 to memberId ascending); net = tax + tip - discount is spread by subtotal: base = floor(|net| x subtotal / S) with exact integer math, then +1 to the first members with a subtotal > 0 in memberId ascending order; added when net >= 0, taken off otherwise. Missing tax/tip/discount = 0. expected has every member on any line (0 allowed) and sums to expectedTotal. error cases expect a SplitException code. percentOf: UI helper, pct % of subtotal rounded half up.",
  "cases": [
    {"name": "shared line, tax and tip spread by subtotal",
     "bill": {"lines": [{"name": "Burger", "amount": 1450, "memberIds": ["a"]}, {"name": "Salad", "amount": 1100, "memberIds": ["b"]},
                        {"name": "Fries to share", "amount": 700, "memberIds": ["c", "a", "b"]}, {"name": "Soda", "amount": 300, "memberIds": ["c"]}],
              "tax": 284, "tip": 600, "discount": 0},
     "expectedTotal": 4434, "expected": {"a": 2104, "b": 1665, "c": 665}},
    {"name": "discount outweighs tax: the net is taken off by subtotal",
     "bill": {"lines": [{"name": "Pizza", "amount": 1000, "memberIds": ["a"]}, {"name": "Pasta", "amount": 2000, "memberIds": ["b"]}], "tax": 120, "tip": 0, "discount": 500},
     "expectedTotal": 2620, "expected": {"a": 873, "b": 1747}},
    {"name": "zero-decimal currency, service charge only, .5 tie goes to memberId ascending",
     "bill": {"lines": [{"name": "Ramen", "amount": 980, "memberIds": ["a"]}, {"name": "Gyoza", "amount": 450, "memberIds": ["b", "a"]}], "tip": 143},
     "expectedTotal": 1573, "expected": {"a": 1326, "b": 247}},
    {"name": "one line one person",
     "bill": {"lines": [{"name": "Coffee", "amount": 350, "memberIds": ["a"]}], "tax": 0, "tip": 0, "discount": 0},
     "expectedTotal": 350, "expected": {"a": 350}},
    {"name": "zero-amount line: its member gets no tax or tip",
     "bill": {"lines": [{"name": "Tap water", "amount": 0, "memberIds": ["b"]}, {"name": "Steak", "amount": 2000, "memberIds": ["a"]}], "tax": 0, "tip": 200, "discount": 0},
     "expectedTotal": 2200, "expected": {"a": 2200, "b": 0}},
    {"name": "net zero (tip equals discount)",
     "bill": {"lines": [{"name": "Pizza", "amount": 1000, "memberIds": ["a"]}, {"name": "Beer", "amount": 500, "memberIds": ["b"]}], "tax": 0, "tip": 150, "discount": 150},
     "expectedTotal": 1500, "expected": {"a": 1000, "b": 500}},
    {"name": "everything discounted to zero",
     "bill": {"lines": [{"name": "Menu A", "amount": 1000, "memberIds": ["a"]}, {"name": "Menu B", "amount": 500, "memberIds": ["b"]}], "tax": 0, "tip": 0, "discount": 1500},
     "expectedTotal": 0, "expected": {"a": 0, "b": 0}},
    {"name": "remainders: the line goes to memberId ascending, the net to the first members with a subtotal, not input order",
     "bill": {"lines": [{"name": "Wine", "amount": 1000, "memberIds": ["c", "b", "a"]}, {"name": "Bread", "amount": 1, "memberIds": ["c"]}], "tax": 0, "tip": 101, "discount": 0},
     "expectedTotal": 1102, "expected": {"a": 368, "b": 367, "c": 367}},
    {"name": "lines with the same people are added up before splitting: no one collects a remainder per line",
     "bill": {"lines": [{"name": "Water", "amount": 100, "memberIds": ["a", "b", "c"]}, {"name": "Bread", "amount": 100, "memberIds": ["c", "a", "b"]},
                        {"name": "Olives", "amount": 100, "memberIds": ["b", "c", "a"]}, {"name": "Wine", "amount": 1001, "memberIds": ["b", "c"]}]},
     "expectedTotal": 1301, "expected": {"a": 100, "b": 601, "c": 600}},
    {"name": "a line with nobody on it is rejected",
     "bill": {"lines": [{"name": "Wine", "amount": 2400, "memberIds": []}], "tax": 0, "tip": 0, "discount": 0}, "error": "UNASSIGNED_ITEM"},
    {"name": "tip on zero subtotal",
     "bill": {"lines": [{"name": "Free refill", "amount": 0, "memberIds": ["a"]}], "tax": 0, "tip": 100, "discount": 0}, "error": "ZERO_SUBTOTAL"},
    {"name": "discount larger than the bill",
     "bill": {"lines": [{"name": "Lunch", "amount": 1000, "memberIds": ["a"]}], "tax": 0, "tip": 0, "discount": 1500}, "error": "NEGATIVE_TOTAL"},
    {"name": "negative tax",
     "bill": {"lines": [{"name": "Lunch", "amount": 1000, "memberIds": ["a"]}], "tax": -10, "tip": 0, "discount": 0}, "error": "NEGATIVE_AMOUNT"},
    {"name": "negative amounts are checked before unassigned lines",
     "bill": {"lines": [{"name": "Wine", "amount": 2400, "memberIds": []}, {"name": "Voucher", "amount": -500, "memberIds": ["a"]}]}, "error": "NEGATIVE_AMOUNT"}
  ],
  "percentOf": [
    {"subtotal": 3550, "pct": 10, "expected": 355},
    {"subtotal": 1005, "pct": 10, "expected": 101},
    {"subtotal": 999, "pct": 12.5, "expected": 125},
    {"subtotal": 4120, "pct": 8.875, "expected": 366},
    {"subtotal": 1234, "pct": 0, "expected": 0}
  ]
}
