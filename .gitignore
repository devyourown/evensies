.DS_Store

# Secrets and local config — never commit
.env
*.env
!*.env.example
deploy/.env
deploy/secrets/*
!deploy/secrets/.gitkeep
deploy/backups/*
!deploy/backups/.gitkeep
# Uploaded files (EVENSIES_STORAGE_DIR): user data, never committed
deploy/data/
server/data/
# The web app build the Docker image copies in (deploy/Dockerfile)
server/src/main/resources/static/app/

# Firebase / Google
**/GoogleService-Info.plist
**/google-services.json
**/firebase_options.dart
**/firebase-adminsdk*.json
**/fcm*.json

# Apple / Android signing
*.p8
*.p12
*.pem
*.mobileprovision
*.cer
*.certSigningRequest
*.jks
*.keystore
**/key.properties
**/upload-keystore*
**/ExportOptions.plist

# Local overrides
**/application-local.yml
**/application-local.properties
**/*.local.yml
